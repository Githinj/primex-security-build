# Primex (Next.js app) — copy to .env.local and fill in.
# The AI worker has its own template at ai_worker/.env.example.

# ── Supabase ──────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── App ───────────────────────────────────────────────────
# Public base URL, used in emails and auth redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Ant Media (camera streaming) ──────────────────────────
# Community Edition local Docker uses app "LiveApp" on :5080 (values shown here).
# Enterprise Edition (prod) uses app "WebRTCAppEE" and MUST be served over SSL on
# :5443 — the app runs on https, so http/ws AMS URLs are blocked as mixed content:
#   ANTMEDIA_URL=https://your-antmedia-server:5443
#   ANTMEDIA_WS_URL=wss://your-antmedia-server:5443/WebRTCAppEE/websocket
#   ANTMEDIA_APP=WebRTCAppEE
ANTMEDIA_URL=http://your-antmedia-server:5080
ANTMEDIA_APP=LiveApp
ANTMEDIA_WS_URL=ws://your-antmedia-server:5080/LiveApp/websocket
ANTMEDIA_WEBHOOK_SECRET=your-webhook-secret
# Enterprise Edition only: the HS256 JWT signing secret (AMS `jwtSecretKey`) — NOT
# a token. The app signs a fresh 60s JWT per REST call and sends it RAW in the
# Authorization header (no "Bearer " prefix); sending this value verbatim returns
# 403 "Invalid App JWT Token". Enables per-stream play AND publish tokens. The
# Python worker (ai_worker/.env) must hold the SAME value. Leave blank on Community.
ANTMEDIA_API_KEY=
# Endpoint cameras publish INTO. Separate from ANTMEDIA_URL because ingest runs on
# its own port and scheme. Leave unset for local Docker and the app derives
# rtmp://<ANTMEDIA_URL host>/<app>; in production set an rtmps:// endpoint, or the
# publish token and the video itself travel in the clear:
#   ANTMEDIA_RTMP_URL=rtmps://your-antmedia-server:443/WebRTCAppEE
ANTMEDIA_RTMP_URL=
# Lifetime of the publish token embedded in the ingest URL (default 365). Cameras
# publish indefinitely, so this is long by nature — re-running "Create broadcast"
# mints a fresh token and is the rotation path.
ANTMEDIA_PUBLISH_TOKEN_TTL_DAYS=365

# ── DigitalOcean Spaces (recordings) ──────────────────────
DO_SPACES_RECORDINGS_BUCKET=primex-recordings
# Full URL form (e.g. https://sgp1.digitaloceanspaces.com). The webhook strips
# the scheme when building virtual-hosted recording URLs, so this same value
# works for both the Next app and the boto3-based ai_worker.
DO_SPACES_ENDPOINT=https://sgp1.digitaloceanspaces.com
DO_SPACES_REGION=sgp1
# Optional — only needed to presign recording playback for a PRIVATE bucket.
DO_SPACES_KEY=
DO_SPACES_SECRET=

# ── Email notifications (Resend) ──────────────────────────
# Optional — without a key, notification emails become logged no-ops.
RESEND_API_KEY=
NOTIFICATIONS_FROM_EMAIL=Primex Security <alerts@primexsecurity.com.au>

# ── Web push (SEC-148) ────────────────────────────────────
# Optional — without a VAPID keypair, push sends become logged no-ops.
# Generate a pair with: npx web-push generate-vapid-keys
# The public key is client-safe (NEXT_PUBLIC_); keep the private key secret.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:alerts@primexsecurity.com.au

# ── Stripe billing (SEC-129) ──────────────────────────────
# Optional — without keys, billing degrades to a "not configured" no-op.
# Use a RESTRICTED key (rk_...) with least-privilege perms, not a secret key.
STRIPE_SECRET_KEY=
# Signing secret from the Stripe webhook endpoint (whsec_...).
STRIPE_WEBHOOK_SECRET=
# Stripe Price IDs for the self-serve tiers (price_...). Enterprise is contact-sales.
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PROFESSIONAL=
