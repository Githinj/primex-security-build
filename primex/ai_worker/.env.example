SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=eyJ...
AI_WORKER_SECRET=your-worker-secret-here
ANTMEDIA_URL=http://your-antmedia-server:5080
# Ant Media application name. Community Edition = LiveApp; Enterprise = WebRTCAppEE.
# Must match ANTMEDIA_APP used by the front-end.
ANTMEDIA_APP=LiveApp
# Enterprise-only: the HS256 JWT signing secret (AMS `jwtSecretKey`) used to sign
# each REST snapshot request — NOT a token. Must be the same value as the
# front-end's ANTMEDIA_API_KEY. Leave BLANK for Community Edition — the worker
# then grabs frames from the HLS playlist instead.
ANTMEDIA_API_KEY=
DO_SPACES_ENDPOINT=https://sgp1.digitaloceanspaces.com
DO_SPACES_KEY=your-spaces-key
DO_SPACES_SECRET=your-spaces-secret
# Frames are uploaded ACL=private; the Next.js app presigns a short-lived GET
# when it renders the alert, using its own DO_SPACES_KEY/SECRET. Those app-side
# credentials must be able to read this bucket or every snapshot 403s.
DO_SPACES_BUCKET=primex-frames

# Port for the /health endpoint. Under Docker, docker-compose.yml publishes
# 8080 on loopback — change both together or the mapping won't follow.
HEALTH_PORT=8080

# Where events that failed to POST are parked for replay_missed.py.
# LEAVE THIS UNSET UNDER DOCKER. The image already points it at /data, which is
# a mounted volume; setting it here would override that via env_file and park
# failed events inside the container, where recreation destroys them.
# Only set it for a bare-metal run, where it defaults to the working directory.
#MISSED_EVENTS_FILE=missed_events.jsonl
