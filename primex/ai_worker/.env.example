SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=eyJ...
AI_WORKER_SECRET=your-worker-secret-here
ANTMEDIA_URL=http://your-antmedia-server:5080
# Ant Media application name. Community Edition = LiveApp; Enterprise = WebRTCAppEE.
# Must match ANTMEDIA_APP used by the front-end.
ANTMEDIA_APP=LiveApp
# Enterprise-only: the HS256 JWT signing secret (AMS `jwtSecretKey`) used to sign
# each REST snapshot request — NOT a token. Must be the same value as the
# front-end's ANTMEDIA_API_KEY. Leave BLANK for Community Edition — the worker
# then grabs frames from the HLS playlist instead.
ANTMEDIA_API_KEY=
DO_SPACES_ENDPOINT=https://sgp1.digitaloceanspaces.com
DO_SPACES_KEY=your-spaces-key
DO_SPACES_SECRET=your-spaces-secret
DO_SPACES_BUCKET=primex-frames
